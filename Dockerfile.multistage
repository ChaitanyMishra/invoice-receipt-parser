# Stage 1: Builder

# We name this stage "builder". This is just a label so Stage 2 can copy files from it later.
FROM python:3.12-slim AS builder

WORKDIR /app

# Copy only the requirements file first. This allows Docker to cache this step.
# If we change our code later, Docker won't re-download all the libraries again.
COPY requirements.txt .

# Install dependencies into /root/.local (the --user flag).
# --no-cache-dir keeps the image small by not saving the downloaded installers.
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runner
# Start a fresh, clean image. It does not contain any of the C++ compilers used in Stage 1.
FROM python:3.12-slim

WORKDIR /app

# Copy ONLY the installed Python packages from the builder stage.
# This brings our FastAPI, SQLModel, and Celery libraries into this clean image.
COPY --from=builder /root/.local /root/.local

# Copy the rest of our source code (app/, frontend/, etc.)
COPY . .

# Make the start.sh script executable so the container is allowed to run it.
RUN chmod +x start.sh

# Tell Linux to look in /root/.local/bin for commands like `uvicorn` and `celery`.
# Without this, the container won't know where these programs are installed.
ENV PATH=/root/.local/bin:${PATH}

# The main process that runs when the container starts.
# It executes start.sh, which runs both Uvicorn and Celery.
CMD ["sh", "start.sh"]
